#!/bin/sh

echo "🧹 Запуск PHP-CS-Fixer через Docker контейнер lara_bridge_app..."

# Исправляем код внутри контейнера
docker compose exec -T lara_bridge_app vendor/bin/php-cs-fixer fix --config=/var/www/.php-cs-fixer.dist.php --allow-risky=yes

# Проверяем, есть ли изменения после фикса
if ! git diff --quiet; then
    echo "❌ PHP-CS-Fixer исправил файлы. Закоммить их и повтори push."
    git add .
    exit 1
fi

echo "✅ Всё чисто!"

